# Heal Connect configuration. Copy to .env for local development.
# Leave the database values empty to use the zero-config JSON file store (.data/).

# --- Database (Lovable Cloud / Postgres) ---
# The Postgres driver turns on when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set.
DATABASE_URL=
SUPABASE_URL=
# Server-only. Never prefix with VITE_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional override: json | postgres
HEAL_CONNECT_STORE=
# Seed demo data into an empty database on first boot (set to false to skip).
HEAL_CONNECT_SEED_DEMO=true

# --- Google sign-in ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to <origin>/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# Long random string used to sign sessions and OAuth state.
SESSION_SECRET=

# --- Demo accounts --- (false in production)
HEAL_CONNECT_DEMO_LOGIN=false

# --- Public ---
VITE_SITE_URL=https://livora-heal.lovable.app
